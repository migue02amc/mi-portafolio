---
import personalDataEs from '../data/personal.json';
import personalDataEn from '../data/en/personal.json';
const isEn = Astro.url.pathname.startsWith('/en');
const personalData = isEn ? personalDataEn : personalDataEs;

type Language = { name: string; level: string; percent: number };
const languages = (personalData as any).languages as Language[] | undefined;
const interests  = (personalData as any).interests  as string[] | undefined;
const skills     = (personalData as any).skills     as string[] | undefined;
---

<section id="about" class="about-section" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Encabezado centrado -->
    <div class="about-header reveal">
      <p class="about-label">{isEn ? 'Get to know me' : 'Conóceme'}</p>
      <h2 class="section-title about-title">{isEn ? 'About Me' : 'Sobre Mí'}</h2>
    </div>

    <!-- ══ GRID PRINCIPAL: foto izq | info der ══ -->
    <div class="about-grid">

      <!-- COLUMNA IZQUIERDA: foto + datos rápidos -->
      <div class="about-left">

        <!-- Tarjeta foto con glow -->
        <div class="about-photo-card reveal" style="transition-delay:.05s">
          <div class="about-photo-glow" aria-hidden="true"></div>
          <img
            src={personalData.photo}
            alt={personalData.photoAlt}
            class="about-photo"
            loading="lazy"
          />
        </div>

        <!-- Datos rápidos como lista compacta -->
        <div class="about-quick-facts reveal" style="transition-delay:.1s">
          <div class="quick-fact">
            <span class="quick-fact-icon">📍</span>
            <div>
              <p class="quick-fact-label">{isEn ? 'Location' : 'Ubicación'}</p>
              <p class="quick-fact-value">{personalData.location}</p>
            </div>
          </div>
          <div class="quick-fact">
            <span class="quick-fact-icon">🎓</span>
            <div>
              <p class="quick-fact-label">{isEn ? 'Education' : 'Formación'}</p>
              <p class="quick-fact-value">{personalData.education}</p>
            </div>
          </div>
          <div class="quick-fact">
            <span class="quick-fact-icon">✉️</span>
            <div>
              <p class="quick-fact-label">{isEn ? 'Email' : 'Correo'}</p>
              <p class="quick-fact-value">{personalData.email}</p>
            </div>
          </div>
        </div>

      </div>

      <!-- COLUMNA DERECHA: bio + skills + idiomas -->
      <div class="about-right">

        <!-- Bio textual -->
        <div class="about-bio-card reveal" style="transition-delay:.15s">
          <div class="about-bio-accent" aria-hidden="true"></div>
          <p class="about-bio-text">{personalData.aboutLong}</p>
        </div>

        <!-- Skills pill cloud -->
        {skills && skills.length > 0 && (
          <div class="about-skills-block reveal" style="transition-delay:.2s">
            <h3 class="about-block-title">
              <span class="about-block-icon">⚡</span> {isEn ? 'Technologies' : 'Tecnologías'}
            </h3>
            <div class="about-skills-grid">
              {skills.map((skill, i) => (
                <span
                  class="skill-pill"
                  style={`animation-delay: ${i * 0.04}s`}
                >
                  {skill}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Idiomas + Intereses en fila -->
        <div class="about-bottom-row">

          <!-- Idiomas -->
          {languages && languages.length > 0 && (
            <div class="about-lang-block reveal" style="transition-delay:.25s">
              <h3 class="about-block-title">
                <span class="about-block-icon">🌐</span> {isEn ? 'Languages' : 'Idiomas'}
              </h3>
              <div class="lang-list">
                {languages.map((lang) => (
                  <div class="lang-item">
                    <div class="lang-meta">
                      <span class="lang-name">{lang.name}</span>
                      <span class="lang-level">{lang.level}</span>
                    </div>
                    <div class="lang-track">
                      <div
                        class="lang-fill"
                        style={`--pct: ${lang.percent}%`}
                        aria-label={`${lang.name}: ${lang.percent}%`}
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Intereses -->
          {interests && interests.length > 0 && (
            <div class="about-interests-block reveal" style="transition-delay:.3s">
              <h3 class="about-block-title">
                <span class="about-block-icon">🎯</span> {isEn ? 'Interests' : 'Intereses'}
              </h3>
              <div class="interests-list">
                {interests.map((item) => (
                  <span class="interest-tag">{item}</span>
                ))}
              </div>
            </div>
          )}

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#about .reveal').forEach((el) => {
    const io = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        (el as HTMLElement).classList.add('visible');
        io.disconnect();
      }
    }, { threshold: 0.08 });
    io.observe(el);
  });
</script>

<style>
  /* ── Sección ── */
  .about-section {
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }

  /* Halo decorativo de fondo */
  .about-section::before {
    content: '';
    position: absolute;
    top: -10%;
    right: -5%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(26,107,204,0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Encabezado ── */
  .about-header {
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
    z-index: 1;
  }

  .about-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--neon);
    margin-bottom: 0.5rem;
  }

  .about-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
  }

  /* ── Grid principal ── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 300px 1fr;
      gap: 3rem;
      align-items: start;
    }
  }

  /* ══ COLUMNA IZQUIERDA ══ */
  .about-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .about-left { align-items: stretch; }
  }

  /* Tarjeta foto */
  .about-photo-card {
    position: relative;
    display: inline-block;
    border-radius: 1.25rem;
    overflow: visible;
  }

  .about-photo-glow {
    position: absolute;
    inset: -12px;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, rgba(26,107,204,0.35), rgba(249,115,22,0.25));
    filter: blur(18px);
    z-index: 0;
    animation: glow-pulse 4s ease-in-out infinite;
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: .5; }
    50%       { opacity: .9; }
  }

  .about-photo {
    position: relative;
    z-index: 1;
    width: 240px;
    height: 300px;
    object-fit: cover;
    object-position: center bottom;
    border-radius: 1.25rem;
    border: 2px solid rgba(26,107,204,0.25);
    box-shadow: 0 20px 60px rgba(15, 9, 9, 0.5);
    display: block;
  }

  @media (min-width: 1024px) {
    .about-photo { width: 100%; height: 320px; }
  }

  /* Badge experiencia */
  .about-exp-badge {
    position: absolute;
    bottom: -1rem;
    right: -1rem;
    z-index: 2;
    background: linear-gradient(135deg, #1a6bcc, #f97316);
    color: #fff;
    padding: .5rem .9rem;
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.2;
    box-shadow: 0 8px 24px rgba(26,107,204,0.45);
  }

  .about-exp-num {
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1;
  }

  .about-exp-text {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
    opacity: .85;
  }

  /* Datos rápidos */
  .about-quick-facts {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 280px;
  }

  @media (min-width: 1024px) { .about-quick-facts { max-width: 100%; } }

  .quick-fact {
    display: flex;
    align-items: flex-start;
    gap: .75rem;
  }

  .quick-fact-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: .1rem;
  }

  .quick-fact-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: .15rem;
  }

  .quick-fact-value {
    font-size: .8rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* ══ COLUMNA DERECHA ══ */
  .about-right {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Bio card con borde acento izquierdo */
  .about-bio-card {
    position: relative;
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.75rem 1.75rem 1.75rem 2rem;
    overflow: hidden;
  }

  /* Barra decorativa izquierda */
  .about-bio-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, #1a6bcc, #f97316);
    border-radius: 4px 0 0 4px;
  }

  .about-bio-text {
    font-size: .95rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin: 0;
  }

  /* Skills block */
  .about-skills-block {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.5rem;
    backdrop-filter: blur(12px);
  }

  .about-block-title {
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: .4rem;
  }

  .about-block-icon { font-size: 1rem; }

  .about-skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .skill-pill {
    display: inline-block;
    padding: .3rem .85rem;
    background: rgba(26,107,204,0.08);
    border: 1px solid rgba(26,107,204,0.22);
    color: #60a5fa;
    border-radius: 999px;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .02em;
    transition: background .2s, border-color .2s, transform .2s, box-shadow .2s;
    cursor: default;
    animation: pill-fade-in .4s ease both;
  }

  @keyframes pill-fade-in {
    from { opacity: 0; transform: scale(.85) translateY(6px); }
    to   { opacity: 1; transform: scale(1)  translateY(0);    }
  }

  .skill-pill:hover {
    background: rgba(26,107,204,0.18);
    border-color: rgba(26,107,204,0.5);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(26,107,204,0.2);
  }

  /* Fila idiomas + intereses */
  .about-bottom-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .about-bottom-row { grid-template-columns: 1fr 1fr; }
  }

  /* Idiomas */
  .about-lang-block,
  .about-interests-block {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.25rem;
    backdrop-filter: blur(12px);
  }

  .lang-list { display: flex; flex-direction: column; gap: .9rem; }

  .lang-item {}

  .lang-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: .4rem;
  }

  .lang-name {
    font-size: .85rem;
    font-weight: 600;
    color: var(--text);
  }

  .lang-level {
    font-size: .72rem;
    color: var(--text-dim);
  }

  .lang-track {
    height: 5px;
    background: rgba(255,255,255,0.06);
    border-radius: 999px;
    overflow: hidden;
  }

  .lang-fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #1a6bcc, #60a5fa);
    transition: width 1.3s cubic-bezier(.4,0,.2,1) .4s;
  }

  .reveal.visible .lang-fill { width: var(--pct); }

  /* Intereses */
  .interests-list {
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  .interest-tag {
    display: block;
    padding: .4rem .85rem;
    background: rgba(249,115,22,0.07);
    border: 1px solid rgba(249,115,22,0.2);
    color: #fb923c;
    border-radius: .5rem;
    font-size: .8rem;
    font-weight: 500;
    transition: background .2s, border-color .2s, transform .2s;
    cursor: default;
  }

  .interest-tag:hover {
    background: rgba(249,115,22,0.14);
    border-color: rgba(249,115,22,0.4);
    transform: translateX(4px);
  }
</style>
