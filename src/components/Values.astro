---
import valuesDataEs from '../data/values.json';
import valuesDataEn from '../data/en/values.json';
const isEn = Astro.url.pathname.startsWith('/en');
const valuesData = isEn ? valuesDataEn : valuesDataEs;
---

<section
  id="values"
  class="py-24 relative overflow-hidden"
  style="scroll-margin-top: 80px;"
>
  <!-- Fondo foto Iztaccíhuatl con overlay -->
  <div
    class="absolute inset-0 z-0"
    style="
      background-image: url('/images/personal/Iztaccihualt.jpg');
      background-size: cover;
      background-position: center 30%;
      background-attachment: fixed;
    "
    aria-hidden="true"
  />
  <div
    class="absolute inset-0 z-0"
    style="background: linear-gradient(180deg, rgba(10,16,12,0.88) 0%, rgba(10,16,12,0.78) 50%, rgba(10,16,12,0.94) 100%);"
    aria-hidden="true"
  />

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16 reveal">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">
        {isEn ? 'Soft Skills' : 'Habilidades Blandas'}
      </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">{isEn ? 'My Soft Skills' : 'Mis Habilidades Blandas'}</h2>
      <p class="text-slate-400 mt-4 max-w-xl mx-auto text-base leading-relaxed">
        {isEn ? 'Technical skills build software; soft skills build the teams that make it possible.' : 'Las habilidades técnicas construyen el software; las habilidades blandas construyen los equipos que lo hacen posible.'}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
      {
        valuesData.map((value, i) => (
          <div
            class="values-card card reveal group"
            style={`transition-delay: ${i * 0.1}s;`}
          >
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-300">
              {value.icon}
            </div>
            <h3 class="text-white font-bold text-base mb-1 group-hover:text-accent transition-colors">
              {value.title}
            </h3>
            <p class="text-xs font-semibold text-highlight uppercase tracking-wider mb-3">
              {value.subtitle}
            </p>
            <p class="text-slate-400 text-sm leading-relaxed">{value.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#values .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.08 }
    );
    io.observe(el);
  });
</script>

<style>
  .values-card {
    text-align: center;
    padding: 2rem 1.5rem;
    background: rgba(2, 11, 24, 0.65);
    border: 1px solid rgba(26, 107, 204, 0.18);
    transition: transform 0.3s ease, border-color 0.3s, box-shadow 0.3s;
  }

  .values-card:hover {
    transform: translateY(-6px);
    border-color: rgba(26, 107, 204, 0.45);
    box-shadow: 0 12px 40px rgba(26, 107, 204, 0.15);
  }
</style>
