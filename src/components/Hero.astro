---
import personalDataEs from '../data/personal.json';
import personalDataEn from '../data/en/personal.json';
const isEn = Astro.url.pathname.startsWith('/en');
const personalData = isEn ? personalDataEn : personalDataEs;
import { getSocialLinks } from '../lib/socialLinks';

const heroSocialLinks = getSocialLinks(
  personalData as unknown as Record<string, string | string[]>,
  personalData.heroSocialLinks
);

import { existsSync, readdirSync } from 'node:fs';
import { extname, join } from 'node:path';

const heroParts = personalData.heroRole.split(' & ');

// CV auto-discovery
const cvValue = (personalData.cv ?? '').trim();
const isExternalCv = /^https?:\/\//i.test(cvValue);
const hasLocalCv =
  cvValue.startsWith('/') &&
  existsSync(join(process.cwd(), 'public', cvValue.replace(/^\//, '')));

let discoveredCv = '';
const cvPublicDir = join(process.cwd(), 'public', 'cv');
if (!isExternalCv && !hasLocalCv && existsSync(cvPublicDir)) {
  const allowedCvExt = new Set(['.pdf', '.doc', '.docx']);
  const candidates = readdirSync(cvPublicDir)
    .filter((f) => allowedCvExt.has(extname(f).toLowerCase()))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));
  if (candidates.length > 0) discoveredCv = `/cv/${candidates[0]}`;
}

const cvHref = isExternalCv ? cvValue : hasLocalCv ? cvValue : discoveredCv;
const hasCv = Boolean(cvHref);

const photoValue = (personalData.photo ?? '').trim();
const isExternalPhoto = /^https?:\/\//i.test(photoValue);
const hasPortrait =
  photoValue !== '' &&
  (isExternalPhoto ||
    existsSync(join(process.cwd(), 'public', photoValue.replace(/^\//, ''))));
---

<section id="home" class="hero-section">

  <!-- ═══════════════════════════════════════════════════
       FONDO: IMAGEN DEL VOLCÁN
       El zoom al hacer scroll se controla en el <script>
       ═══════════════════════════════════════════════════ -->
  <div class="hero-bg-wrapper">
    <div class="hero-bg" id="hero-bg"></div>

    <!-- Overlay: oscurece el fondo para que se vea el texto.
         Al hacer scroll este overlay también desaparece para
         que el volcán quede completamente limpio. -->
    <div class="hero-overlay" id="hero-overlay" aria-hidden="true"></div>
  </div>

  <!-- ═══════════════════════════════════════════════════
       CONTENIDO: foto + nombre + botones
       Al hacer scroll TODO esto se desvanece (opacity → 0)
       y solo queda el volcán acercándose.
       ═══════════════════════════════════════════════════ -->
  <div class="hero-content" id="hero-content">

    <!-- Foto de perfil circular -->
    {hasPortrait && (
      <div class="hero-photo-wrapper reveal" style="transition-delay:0.05s">
        <div class="hero-photo-ring"></div>
        <img
          src={personalData.photo}
          alt={personalData.photoAlt ?? 'Foto de perfil'}
          class="hero-photo"
          loading="eager"
        />
      </div>
    )}

    <!-- Nombre + Rol -->
    <div class="hero-text reveal" style="transition-delay:0.15s">
      <h1 class="hero-name">
        <span class="gradient-text">{personalData.name}</span>
      </h1>
      <p class="hero-role">
        {heroParts.length > 1
          ? <>{heroParts[0]}&nbsp;<span class="text-highlight">&amp;</span>&nbsp;{heroParts.slice(1).join(' & ')}</>
          : heroParts[0]
        }
      </p>
    </div>

    <!-- Botones CTA -->
    <div class="hero-ctas reveal" style="transition-delay:0.25s">
      <a href="#projects" class="btn-primary">{isEn ? 'View Projects' : 'Ver Proyectos'}</a>
      <a href="#contact"  class="btn-secondary">{isEn ? 'Contact Me' : 'Contáctame'}</a>
      {hasCv && (
        <a href={cvHref} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          {isEn ? 'Download CV' : 'Descargar CV'}
        </a>
      )}
    </div>

    <!-- Redes sociales -->
    <div class="hero-socials reveal" style="transition-delay:0.35s">
      {heroSocialLinks.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer"
           class="hero-social-link" aria-label={link.label}>
          <iconify-icon icon={link.icon} width="24" height="24" aria-hidden="true" />
        </a>
      ))}
    </div>

  </div>

  <!-- Indicador de scroll (desaparece al bajar) -->
  <div class="scroll-indicator" id="scroll-indicator">
    <div class="mouse">
      <div class="wheel"></div>
    </div>
    <span class="text-xs uppercase tracking-widest font-semibold">{isEn ? 'Scroll' : 'Desliza'}</span>
  </div>

</section>

<!-- ═══════════════════════════════════════════════════════════
     SCRIPT: Efecto de scroll
     • El volcán se acerca (zoom hacia el pico)
     • La foto + nombre + botones se desvanecen
     ═══════════════════════════════════════════════════════════ -->
<script>
  (() => {
    const bg      = document.getElementById('hero-bg')      as HTMLElement | null;
    const overlay = document.getElementById('hero-overlay') as HTMLElement | null;
    const content = document.getElementById('hero-content') as HTMLElement | null;
    const hint    = document.getElementById('scroll-hint')  as HTMLElement | null;

    // Reveal al cargar
    document.querySelectorAll('#home .reveal').forEach((el) => {
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          (el as HTMLElement).classList.add('visible');
          io.disconnect();
        }
      }, { threshold: 0.05 });
      io.observe(el);
    });

    // ─── Scroll handler ───────────────────────────────────────
    let ticking = false;

    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;

      requestAnimationFrame(() => {
        const scrollY = window.scrollY;
        const vh      = window.innerHeight;

        // ▸ progress va de 0 (arriba del todo) a 1 (cuando
        //   has bajado el 70% de la pantalla).
        //   Baja este valor (p.ej. 0.5) para que el efecto
        //   termine antes.
        const progress = Math.min(scrollY / (vh * 0.7), 1);

        // ── VOLCÁN: zoom hacia el PICO ────────────────────────
        if (bg) {
          // Escala de 1.0 → 1.45 conforme bajas.
          // Sube el segundo número para más acercamiento (p.ej. 0.6)
          // Bájalo para menos acercamiento (p.ej. 0.2)
          const scale = 1 + progress * 0.45;
          bg.style.transform = `scale(${scale})`;
          // transform-origin: 'center top' hace que el PICO sea el
          // centro del zoom → el pico se acerca, el valle se aleja
        }

        // ── OVERLAY: se aclara al hacer zoom para ver el volcán ──
        if (overlay) {
          // La opacidad baja de 1 → 0 al llegar a progress=1
          overlay.style.opacity = String(Math.max(1 - progress * 1.2, 0));
        }

        // ── CONTENIDO: foto + nombre se desvanecen ────────────
        if (content) {
          // Opacity 1 → 0 mientras bajas
          // El "* 2" hace que desaparezca rápido (antes del 50% del scroll)
          // Cámbialo a "* 1.5" para desvanecimiento más lento
          const opacity = Math.max(1 - progress * 2, 0);
          content.style.opacity  = String(opacity);
          // También sube un poco mientras desaparece (efecto elegante)
          content.style.transform = `translateY(${-progress * 30}px)`;
        }

        // ── SCROLL HINT ───────────────────────────────────────
        if (hint) {
          hint.style.opacity = String(Math.max(1 - progress * 4, 0));
        }

        ticking = false;
      });
    }, { passive: true });
  })();
</script>

<style>
  /* ════════════════════════════════════════════════════════════
     SECCIÓN PRINCIPAL
     ════════════════════════════════════════════════════════════ */
  .hero-section {
    position: relative;
    /* ▸ ALTURA DEL HERO
       100svh = pantalla completa
       115svh = un poco más que la pantalla */
    height: 100svh;
    min-height: 580px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
  }

  /* ════════════════════════════════════════════════════════════
     FONDO: VOLCÁN
     ════════════════════════════════════════════════════════════ */
  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    /* ▸ Margen extra (-8%) para que el zoom no deje
       bordes blancos en los extremos. No es necesario tocar esto. */
    inset: -8%;
    background-image: url('/images/personal/Citlaltepec.jpg');
    background-size: cover;

    /* ▸ POSICIÓN DE LA IMAGEN DEL VOLCÁN
       "center top"  → pico justo en la parte superior
       "center 5%"   → casi arriba, pico bien visible sobre tu foto ← AHORA
       "center 30%"  → muestra más cuerpo del volcán */
    background-position: center 50%;

    /* ▸ El zoom se aplica desde el PICO (arriba-centro).
       Si cambias transform-origin, cambia el punto de zoom:
       "center top"    → el pico crece hacia ti ✓
       "center center" → zoom centrado
       "center bottom" → el primer plano crece hacia ti */
    transform-origin: center top;
    transform: scale(1);
    will-change: transform;

    /* ▸ BRILLO Y SATURACIÓN DE LA FOTO
       brightness: 0.0 (negro) → 1.0 (original)
       saturate:   0.0 (gris)  → 1.0 (colores originales) */
    filter: saturate(0.8) brightness(0.55);
  }

  /* ▸ OVERLAY OSCURO
     Solo oscurece en el último tramo (donde está el texto).
     El resto del volcán se ve casi limpio. */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(2, 11, 24, 0.0)  0%,    /* ← Arriba: transparente total */
      rgba(2, 11, 24, 0.0) 50%,    /* ← Mitad: el volcán se ve limpio */
      rgba(2, 11, 24, 0.45) 72%,   /* ← Empieza a oscurecer */
      rgba(2, 11, 24, 0.85) 100%   /* ← Abajo: oscuro para leer el texto */
    );
  }

  /* ════════════════════════════════════════════════════════════
     CONTENIDO: foto + nombre + botones
     ════════════════════════════════════════════════════════════ */
  .hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    width: 100%;
    max-width: 680px;

    /* ▸ SEPARACIÓN DESDE EL FONDO DE LA PANTALLA
       ─────────────────────────────────────────────────────
       padding-bottom = espacio entre tu contenido y el borde inferior

       Ejemplos:
         3rem  → muy pegado abajo
         5rem  → un poco de aire     ← AHORA
         8rem  → más separado del borde
        12rem  → bastante arriba del fondo
       ─────────────────────────────────────────────────────
       El volcán siempre ocupa el espacio vacío que queda arriba. */
    /* ▸ SEPARACIÓN DESDE EL FONDO
       8rem = tu foto y nombre quedan en la zona central-baja,
       bien visibles sin estar demasiado abajo.
       Sube a 12rem para más arriba, baja a 4rem para más abajo. */
    padding: 0 1.5rem 2rem;

    /* Heredado del script para el fade-out */
    will-change: opacity, transform;
  }

  /* ════════════════════════════════════════════════════════════
     FOTO DE PERFIL
     ════════════════════════════════════════════════════════════ */
  .hero-photo-wrapper {
    position: relative;

    /* ▸ TAMAÑO DE LA FOTO
       Cámbialo a gusto.
       Móvil: 200px  |  Tablet: 240px  |  Desktop: 270px */
    width: 200px;
    height: 200px;
  }

  @media (min-width: 640px) {
    .hero-photo-wrapper { width: 240px; height: 240px; }
  }

  @media (min-width: 1024px) {
    .hero-photo-wrapper { width: 270px; height: 270px; }
  }

  /* Anillo pulsante alrededor de la foto */
  .hero-photo-ring {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1a6bcc, #f97316 70%);
    opacity: 0.7;
    filter: blur(4px);
    animation: ring-pulse 3s ease-in-out infinite;
  }

  @keyframes ring-pulse {
    0%, 100% { opacity: 0.45; transform: scale(1);    }
    50%       { opacity: 0.85; transform: scale(1.05); }
  }

  .hero-photo {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;

    /* ▸ ENCUADRE DE LA CARA DENTRO DEL CÍRCULO
       "under 0%"  → muy arriba (solo cabeza)
       "center 15%" → ligeramente arriba (cara centrada) ← recomendado
       "center 50%" → centro exacto de la foto
       Ajústalo hasta que tu cara quede bien centrada. */
    object-position: center 100%;

    border: 4px solid rgba(2, 11, 24, 0.85);
    box-shadow:
      0 0 0 1px rgba(26, 107, 204, 0.3),
      0 0 50px rgba(26, 107, 204, 0.35),
      0 24px 60px rgba(0, 0, 0, 0.7);
  }

  /* ════════════════════════════════════════════════════════════
     TEXTO: NOMBRE Y ROL
     ════════════════════════════════════════════════════════════ */
  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .hero-name {
    /* ▸ TAMAÑO DEL NOMBRE
       clamp(mínimo, relativo, máximo)
       Sube el tercer número para más grande en escritorio. */
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.1;
    margin: 0;
    color: #fff;
  }

  .hero-role {
    font-size: clamp(0.8rem, 1.6vw, 1rem);
    font-weight: 300;
    color: #94a3b8;
    margin: 0;
  }

  /* ════════════════════════════════════════════════════════════
     BOTONES Y REDES
     ════════════════════════════════════════════════════════════ */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin-top: 0.25rem;
  }

  .hero-socials {
    display: flex;
    gap: 1.2rem;
    margin-top: 0.1rem;
  }

  .hero-social-link {
    color: #475569;
    transition: color 0.25s, transform 0.25s;
  }
  .hero-social-link:hover {
    color: var(--accent-green);
    transform: translateY(-3px);
  }

  /* ════════════════════════════════════════════════════════════
     INDICADOR DE SCROLL
     ════════════════════════════════════════════════════════════ */
  .scroll-hint {
    position: absolute;
    bottom: 1.75rem;
    left: 2rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .scroll-hint-text {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #334155;
  }

  .scroll-hint-mouse {
    width: 20px;
    height: 33px;
    border: 2px solid #334155;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    padding-top: 4px;
  }

  .scroll-hint-dot {
    width: 3px;
    height: 6px;
    background: var(--accent);
    border-radius: 2px;
    animation: scroll-dot 1.8s ease-in-out infinite;
  }

  @keyframes scroll-dot {
    0%   { transform: translateY(0);    opacity: 1; }
    75%  { transform: translateY(10px); opacity: 0; }
    100% { transform: translateY(0);    opacity: 0; }
  }
</style>
