---
import testimonialsDataEs from '../data/testimonials.json';
import testimonialsDataEn from '../data/en/testimonials.json';
const isEn = Astro.url.pathname.startsWith('/en');
const testimonialsData = isEn ? testimonialsDataEn : testimonialsDataEs;

// Sección oculta mientras no haya testimonios reales
const visibleTestimonials = testimonialsData.filter((t) => !t.hidden);
const hasTestimonials = visibleTestimonials.length > 0;
---

{
  hasTestimonials && (
    <section id="testimonials" class="py-24 bg-slate-900/25" style="scroll-margin-top: 80px;">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
          <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">
            {isEn ? 'What they say' : 'Lo que dicen'}
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">
            {isEn ? 'Recommendations' : 'Recomendaciones'}
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {visibleTestimonials.map((t, i) => (
            <div
              class="card testimonial-card reveal group"
              style={`transition-delay: ${i * 0.1}s;`}
            >
              <!-- Quote icon -->
              <svg
                class="w-8 h-8 text-accent opacity-40 mb-4"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>

              <p class="text-slate-300 text-base leading-relaxed italic mb-6">
                "{t.quote}"
              </p>

              <div class="flex items-center gap-3 pt-4 border-t border-white/5">
                {t.avatar ? (
                  <img
                    src={t.avatar}
                    alt={t.name}
                    class="w-10 h-10 rounded-full object-cover border border-accent/20"
                  />
                ) : (
                  <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm text-white shrink-0"
                    style="background: linear-gradient(135deg, #4aa15c, #f4a261);">
                    {t.initials}
                  </div>
                )}
                <div>
                  <p class="text-white font-semibold text-sm">{t.name}</p>
                  <p class="text-slate-500 text-xs">{t.role} · {t.institution}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll('#testimonials .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.08 }
    );
    io.observe(el);
  });
</script>

<style>
  .testimonial-card {
    transition: transform 0.3s ease, border-color 0.3s, box-shadow 0.3s;
  }
  .testimonial-card:hover {
    transform: translateY(-4px);
  }
</style>
