---
import experienceDataEs from '../data/experience.json';
import experienceDataEn from '../data/en/experience.json';
const isEn = Astro.url.pathname.startsWith('/en');
const experienceData = isEn ? experienceDataEn : experienceDataEs;

const typeLabels: Record<string, string> = isEn ? {
  internship: 'Internship',
  'social-service': 'Social Service',
  education: 'Education',
} : {
  internship: 'Prácticas',
  'social-service': 'Servicio Social',
  education: 'Formación',
};

const typeColors: Record<string, string> = {
  internship: '#4aa15c',
  'social-service': '#f4a261',
  education: '#74c69d',
};
---

<section id="experience" class="py-24 bg-slate-900/20" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">
        {isEn ? 'Professional Path' : 'Trayectoria profesional'}
      </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">{isEn ? 'Experience' : 'Experiencia'}</h2>
    </div>

    <div class="max-w-3xl mx-auto relative">
      <!-- Línea vertical animada -->
      <div class="timeline-track" aria-hidden="true"></div>

      <div class="space-y-10">
        {
          experienceData.map((entry, i) => {
            const color = typeColors[entry.type] ?? '#4aa15c';
            const label = typeLabels[entry.type] ?? entry.type;
            return (
              <div
                class="timeline-item reveal"
                style={`transition-delay: ${i * 0.12}s;`}
              >
                <!-- Dot en la línea -->
                <div class="timeline-dot" style={`background: ${color}; box-shadow: 0 0 0 4px ${color}28;`} aria-hidden="true" />

                <div class="card timeline-card group">
                  <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                    <div>
                      <span
                        class="timeline-badge"
                        style={`background: ${color}18; color: ${color}; border-color: ${color}35;`}
                      >
                        {label}
                      </span>
                      <h3 class="text-white font-bold text-lg mt-2 group-hover:text-accent transition-colors">
                        {entry.title}
                      </h3>
                      <p class="text-sm font-semibold mt-0.5" style={`color: ${color};`}>
                        {entry.company}
                        {entry.institution && (
                          <span class="text-slate-500 font-normal"> · {entry.institution}</span>
                        )}
                      </p>
                    </div>
                    <div class="text-right shrink-0">
                      <span class="text-xs font-mono text-slate-500">{entry.period}</span>
                      <p class="text-xs text-slate-600 mt-0.5">{entry.location}</p>
                    </div>
                  </div>

                  <ul class="space-y-2 mb-4">
                    {entry.achievements.map((a) => (
                      <li class="flex items-start gap-2 text-slate-400 text-sm leading-relaxed">
                        <span class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full" style={`background: ${color};`} />
                        {a}
                      </li>
                    ))}
                  </ul>

                  <div class="flex flex-wrap gap-2 pt-3 border-t border-white/5">
                    {entry.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#experience .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.08 }
    );
    io.observe(el);
  });
</script>

<style>
  .timeline-track {
    position: absolute;
    left: 1.125rem;
    top: 0;
    width: 2px;
    height: 100%;
    background: linear-gradient(180deg, #4aa15c44 0%, #f4a26144 60%, transparent 100%);
    border-radius: 999px;
  }

  @media (min-width: 640px) {
    .timeline-track {
      left: 1.375rem;
    }
  }

  .timeline-item {
    position: relative;
    padding-left: 3rem;
  }

  @media (min-width: 640px) {
    .timeline-item {
      padding-left: 3.5rem;
    }
  }

  .timeline-dot {
    position: absolute;
    left: 0.5rem;
    top: 1.5rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.15);
    z-index: 1;
    transition: transform 0.3s ease;
  }

  @media (min-width: 640px) {
    .timeline-dot {
      left: 0.75rem;
    }
  }

  .timeline-item:hover .timeline-dot {
    transform: scale(1.2);
  }

  .timeline-card {
    transition: transform 0.3s ease, border-color 0.3s, box-shadow 0.3s;
  }

  .timeline-item:hover .timeline-card {
    transform: translateX(4px);
  }

  .timeline-badge {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid;
  }
</style>
